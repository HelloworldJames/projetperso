    Un CPU précis est obligatoire.
    """

    if not cpu:
        return None

    cpu_texte = str(
        cpu
    )

    generation = (
        extraire_generation_intel(
            cpu_texte
        )
    )

    if generation is not None:
        if generation <= 5:
            base = 100

        elif generation <= 7:
            base = 140

        elif generation <= 9:
            base = 190

        elif generation <= 11:
            base = 260

        elif generation == 12:
            base = 330

        elif generation == 13:
            base = 400

        else:
            base = 460

        if cpu_texte.lower().startswith(
            "i3-"
        ):
            base -= 40

        elif cpu_texte.lower().startswith(
            "i7-"
        ):
            base += 45

        elif cpu_texte.lower().startswith(
            "i9-"
        ):
            base += 90

        return max(
            70,
            base,
        )

    serie_ryzen = (
        extraire_serie_ryzen(
            cpu_texte
        )
    )

    if serie_ryzen is not None:
        bases = {
            3: 170,
            4: 220,
            5: 280,
