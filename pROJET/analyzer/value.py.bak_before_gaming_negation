def extraire_generation_intel(cpu):
    if not cpu:
        return None

    match = re.search(
        r"\bi[3579]-(\d{4,5})",
        str(cpu),
        flags=re.IGNORECASE,
    )

    if not match:
        return None

    modele = match.group(1)

    if len(modele) == 4:
        return int(
            modele[0]
        )

    if len(modele) == 5:
        return int(
            modele[:2]
        )

    return None


def extraire_serie_ryzen(cpu):
    if not cpu:
        return None

    match = re.search(
        r"\bRyzen\s+[3579]\s+(\d{4,5})",
        str(cpu),
        flags=re.IGNORECASE,
    )

    if not match:
        return None

    modele = match.group(1)

    try:
        return int(
            modele[0]
        )

    except (
        TypeError,
        ValueError,
    ):
        return None


