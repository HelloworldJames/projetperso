# ============================================================
# DETECTION GENERALE
# ============================================================

def detecter_composants(annonce):
    texte = texte_annonce(
        annonce
    )

    detection = {
        "gpu":
            detecter_gpu(
                texte
            ),

        "cpu":
            detecter_cpu(
                texte
            ),

        "ram":
            detecter_ram(
                texte
            ),

        "stockage":
            detecter_stockage(
                texte
            ),

        "apple_chip":
            detecter_puce_apple(
                texte
            ),
    }

    machine_apple = (
        detecter_machine_apple(
            annonce
        )
    )

    if machine_apple:
        detection[
            "machine_apple"
        ] = machine_apple

    machine_portable_windows = (
        detecter_machine_portable_windows(
            annonce
        )
    )

    if machine_portable_windows:
        detection[
            "machine_portable_windows"
        ] = machine_portable_windows

    return detection
