import re
import unicodedata


# ============================================================
# PC HUNTER - EXTRACTION DES COMPOSANTS
# ============================================================


def normaliser_texte(texte):
    """
    Rend le texte vendeur plus régulier pour les regex.

    Exemples tolérés :
    Rysen -> Ryzen
    Rizen -> Ryzen
    Ge Force -> GeForce
    N Vidia -> Nvidia
    tmi3 -> i3
    Giga -> Go
    """

    texte = str(
        texte or ""
    )

    texte = unicodedata.normalize(
        "NFKD",
        texte,
    )

    texte = "".join(
        caractere
        for caractere in texte
        if not unicodedata.combining(
            caractere
        )
    )

    texte = texte.lower()

    corrections = {
        "rysen": "ryzen",
        "rizen": "ryzen",
        "raizen": "ryzen",
        "ge force": "geforce",
        "n vidia": "nvidia",
        "tmi3": "i3",
        "tmi5": "i5",
        "tmi7": "i7",
        "giga octets": "go",
        "gigaoctets": "go",
        "giga": "go",
    }

    for ancien, nouveau in (
        corrections.items()
    ):
        texte = texte.replace(
            ancien,
            nouveau,
        )

    texte = re.sub(
        r"\s+",
        " ",
        texte,
    )

    return texte.strip()


def texte_annonce(annonce):
    return normaliser_texte(
        " ".join(
            [
                str(
                    getattr(
                        annonce,
                        "titre",
                        "",
                    )
                    or ""
                ),
                str(
                    getattr(
                        annonce,
                        "description",
                        "",
                    )
                    or ""
                ),
            ]
        )
    )


def ajouter_unique(
    liste,
    valeur,
):
    if (
        valeur
        and
        valeur not in liste
    ):
        liste.append(
            valeur
        )


# ============================================================
# GPU NVIDIA / AMD
# ============================================================

def detecter_gpu(texte):
    resultats = []

    # RTX 2060 / 3060 Ti / 4070 Super...
    for match in re.finditer(
        r"\b(?:nvidia\s+)?"
        r"(?:geforce\s+)?"
        r"rtx\s*"
        r"([2-5]\d{3})"
        r"\s*(ti|super)?\b",
        texte,
        flags=re.IGNORECASE,
    ):
        modele = match.group(1)
        suffixe = match.group(2)

        valeur = (
            f"RTX {modele}"
        )

        if suffixe:
            if (
                suffixe.lower()
                == "ti"
            ):
                valeur += " Ti"

            else:
                valeur += " Super"

        ajouter_unique(
            resultats,
            valeur,
        )

    # GTX 960M / 1050 Ti / 1660 Super...
    for match in re.finditer(
        r"\b(?:nvidia\s+)?"
        r"(?:geforce\s+)?"
        r"gtx\s*"
        r"(\d{3,4})"
        r"\s*(ti|super|m)?\b",
        texte,
        flags=re.IGNORECASE,
    ):
        modele = match.group(1)
        suffixe = match.group(2)

        valeur = (
            f"GTX {modele}"
        )

        if suffixe:
            suffixe = (
                suffixe.lower()
            )

            if suffixe == "ti":
                valeur += " Ti"

            elif suffixe == "super":
                valeur += " Super"

            elif suffixe == "m":
                valeur += "M"

        ajouter_unique(
            resultats,
            valeur,
        )

    # RX 6600 / 6700 XT / 7900 XTX...
    for match in re.finditer(
        r"\b(?:amd\s+)?"
        r"(?:radeon\s+)?"
        r"rx\s*"
        r"(\d{3,4})"
        r"\s*(xtx|xt|m)?\b",
        texte,
        flags=re.IGNORECASE,
    ):
        modele = match.group(1)
        suffixe = match.group(2)

        valeur = (
            f"RX {modele}"
        )

        if suffixe:
            valeur += (
                " "
                + suffixe.upper()
            )

        ajouter_unique(
            resultats,
            valeur,
        )

    return resultats


# ============================================================
# CPU INTEL / AMD
# ============================================================

def detecter_cpu(texte):
    resultats = []

    # i5-13400F / i7 6700HQ / i5-10400...
    for match in re.finditer(
        r"\b(?:intel\s+)?"
        r"(?:core\s+)?"
        r"(i[3579])"
        r"[\s\-]*"
        r"(\d{4,5})"
        r"\s*"
        r"([a-z]{0,3})\b",
        texte,
        flags=re.IGNORECASE,
    ):
        famille = (
            match.group(1)
            .lower()
        )

        modele = (
            match.group(2)
        )

        suffixe = (
            match.group(3)
            or ""
        ).upper()

        valeur = (
            f"{famille}-"
            f"{modele}"
            f"{suffixe}"
        )

        ajouter_unique(
            resultats,
            valeur,
        )

    # Ryzen 5 5600 / Ryzen 7 5800X / 7840HS...
    for match in re.finditer(
        r"\bryzen\s*"
        r"([3579])"
        r"\s*"
        r"(\d{4,5})"
        r"\s*"
        r"([a-z]{0,3})\b",
        texte,
        flags=re.IGNORECASE,
    ):
        gamme = match.group(1)
        modele = match.group(2)

        suffixe = (
            match.group(3)
            or ""
        ).upper()

        valeur = (
            f"Ryzen {gamme} "
            f"{modele}"
            f"{suffixe}"
        )

        ajouter_unique(
            resultats,
            valeur,
        )

    return resultats


# ============================================================
# APPLE SILICON
# ============================================================

def detecter_puce_apple(texte):
    resultats = []

    for match in re.finditer(
        r"\b(?:apple\s+)?"
        r"(m[1-5])"
        r"\s*(pro|max|ultra)?\b",
        texte,
        flags=re.IGNORECASE,
    ):
        puce = (
            match.group(1)
            .upper()
        )

        suffixe = (
            match.group(2)
        )

        if suffixe:
            puce += (
                " "
                + suffixe.title()
            )

        ajouter_unique(
            resultats,
            puce,
        )

    return resultats


# ============================================================
# RAM
# ============================================================

def detecter_ram(texte):
    resultats = []

    capacites = (
        "4|6|8|12|16|18|24|32|"
        "36|48|64|96|128"
    )

    motifs = [
        (
            rf"\b({capacites})\s*"
            r"(?:go|gb)"
            r"\s*(ddr[345])?"
            r"(?:\s*(?:de\s+)?ram)?\b"
        ),
        (
            r"\b(?:ram|memoire(?:\s+vive)?)"
            r"\s*[:\-]?\s*"
            rf"({capacites})\s*"
            r"(?:go|gb)"
            r"\s*(ddr[345])?\b"
        ),
    ]

    candidats = []

    for motif in motifs:
        for match in re.finditer(
            motif,
            texte,
            flags=re.IGNORECASE,
        ):
            nombre = (
                match.group(1)
            )

            ddr = (
                match.group(2)
                if (
                    match.lastindex
                    and
                    match.lastindex >= 2
                )
                else None
            )

            debut = max(
                0,
                match.start() - 25,
            )

            fin = min(
                len(texte),
                match.end() + 25,
            )

            contexte = texte[
                debut:fin
            ]

            if (
                (
                    "ssd" in contexte
                    or
                    "nvme" in contexte
                    or
                    "disque" in contexte
                    or
                    "stockage" in contexte
                )
                and not (
                    "ram" in contexte
                    or
                    "memoire" in contexte
                    or
                    "ddr" in contexte
                )
            ):
                continue

            score = 0

            if (
                "ram" in contexte
                or
                "memoire" in contexte
            ):
                score += 3

            if ddr:
                score += 2

            candidats.append(
                (
                    score,
                    nombre,
                    ddr,
                )
            )

    if not candidats:
        return resultats

    candidats.sort(
        key=lambda item: item[0],
        reverse=True,
    )

    (
        _,
        nombre,
        ddr,
    ) = candidats[0]

    valeur = (
        f"{nombre} Go"
    )

    if ddr:
        valeur += (
            " "
            + ddr.upper()
        )

    ajouter_unique(
        resultats,
        valeur,
    )

    return resultats


