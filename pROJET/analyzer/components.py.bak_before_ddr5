# ============================================================

def detecter_taille_ecran_portable(texte):
    match = re.search(
        r"\b("
        r"11(?:[.,]6)?|12(?:[.,]5)?|13(?:[.,]3)?|14|"
        r"15(?:[.,]6)?|16|17(?:[.,]3)?|18"
        r")\s*(?:pouces?|\"|inch)\b",
        texte,
        flags=re.IGNORECASE,
    )

    if not match:
        return None

    return (
        match.group(1)
        .replace(",", ".")
        + " pouces"
    )


def detecter_frequence_ecran(texte):
    match = re.search(
        r"\b(60|75|90|120|144|165|180|240|300|360)"
        r"\s*hz\b",
        texte,
        flags=re.IGNORECASE,
    )

    if not match:
        return None

    return (
        match.group(1)
        + " Hz"
    )


