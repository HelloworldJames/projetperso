# ============================================================
# NORMALISATION
# ============================================================

def normaliser_reference(texte):
    texte = str(
        texte or ""
    )

    texte = unicodedata.normalize(
        "NFKD",
        texte,
    )

    texte = "".join(
        caractere
        for caractere in texte
        if not unicodedata.combining(
            caractere
        )
    )

    texte = texte.lower()

    return re.sub(
        r"[^a-z0-9]+",
        "",
        texte,
    )


