def extraire_nombre_go(valeur):
    if not valeur:
        return None

    match = re.search(
        r"\b(\d+)\s*go\b",
        str(valeur),
        flags=re.IGNORECASE,
    )

    if not match:
        return None

    try:
        return int(
            match.group(1)
        )

    except ValueError:
        return None


def stockage_en_go(valeur):
    if not valeur:
        return None

    texte = str(
        valeur
    ).lower()

    match_to = re.search(
        r"(\d+(?:[.,]\d+)?)"
        r"\s*to\b",
        texte,
    )

    if match_to:
        try:
            return int(
                float(
                    match_to.group(1)
                    .replace(
                        ",",
                        ".",
                    )
                )
                * 1024
            )

        except ValueError:
            return None

    match_go = re.search(
        r"(\d+)\s*go\b",
        texte,
    )

    if match_go:
        try:
            return int(
                match_go.group(1)
            )

        except ValueError:
            return None

    return None


