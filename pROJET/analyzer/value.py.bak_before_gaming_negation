def ajustement_ram_apple(ram):
    quantite = extraire_nombre_go(
        ram
    )

    if quantite is None:
        return 0

    if quantite >= 64:
        return 260

    if quantite >= 48:
        return 220

    if quantite >= 32:
        return 170

    if quantite >= 24:
        return 120

    if quantite >= 16:
        return 70

    return 0


def ajustement_stockage_apple(
    stockage,
    puce=None,
):
    """
    Sur Apple Silicon, le stockage interne est un SSD :
    on peut appliquer un bonus de capacité.

    Sur un ancien Mac Intel, une simple mention "1 To"
    peut désigner un HDD. On ne lui donne donc PAS
    automatiquement la valeur d'un SSD.
    """

    if not stockage:
        return 0

    texte = str(
        stockage
    ).lower()

    stockage_rapide_confirme = (
        puce is not None
        or
        "ssd" in texte
        or
        "nvme" in texte
    )

    if not stockage_rapide_confirme:
        return 0

    capacite = stockage_en_go(
        stockage
    )

    if capacite is None:
        return 0

    if capacite >= 4096:
        return 350

    if capacite >= 2048:
        return 240

    if capacite >= 1024:
        return 140

    if capacite >= 512:
        return 70

    return 0


def ajustement_ecran_apple(
    modele,
    ecran,
):
    if not ecran:
        return 0

    try:
        taille = float(
            str(ecran)
            .replace(
                " pouces",
                "",
            )
        )

    except ValueError:
        return 0

    if modele == "MacBook Pro":
        if taille >= 16:
            return 180

        if taille >= 14:
            return 100

    if (
        modele == "iMac"
        and
        taille >= 27
    ):
        return 70

    return 0


def trouver_base_intel_apple(
    modele,
    annee,
):
    table = (
        APPLE_INTEL_ANNEE_BASE.get(
            modele
        )
    )

    if not table:
        return None

    if annee in table:
        return table[
            annee
        ]

    annees = sorted(
        table
    )

    inferieures = [
        annee_connue
        for annee_connue in annees
        if annee_connue <= annee
    ]

    superieures = [
        annee_connue
        for annee_connue in annees
        if annee_connue >= annee
    ]

    if (
        not inferieures
        or
        not superieures
    ):
        return None

    annee_basse = max(
        inferieures
    )

    annee_haute = min(
        superieures
    )

    if (
        annee_basse
        ==
        annee_haute
    ):
        return table[
            annee_basse
        ]

    valeur_basse = table[
        annee_basse
    ]

    valeur_haute = table[
        annee_haute
    ]

    proportion = (
        (annee - annee_basse)
        /
        (annee_haute - annee_basse)
    )

    return round(
        valeur_basse
        +
        (
            valeur_haute
            -
            valeur_basse
        )
        *
        proportion
    )


