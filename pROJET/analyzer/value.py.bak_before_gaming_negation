    # --------------------------------------------------------
    # MODELE APPLE TROUVE MAIS PAS ASSEZ PRECIS
    # --------------------------------------------------------

    if base is None:
        raison = (
            "Modèle Apple identifié, mais année ou puce "
            "insuffisante pour une valorisation fiable"
        )

        estimation = {
            "statut":
                "MACHINE_COMPLETE_REQUISE",

