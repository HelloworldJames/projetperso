                },

            "mode_valorisation":
                "machine_complete_apple",

            "machine":
                machine,
        }

        return (
            0,
            composants,
            estimation,
        )

    # --------------------------------------------------------
    # CONFIGURATION
    # --------------------------------------------------------

    ajustements = (
        ajustement_ram_apple(
