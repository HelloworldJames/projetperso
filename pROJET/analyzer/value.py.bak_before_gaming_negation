            5: 35,
            6: 60,
            7: 90,
            8: 120,
            9: 140,
        }

        ajustement_generation = (
            ajustements_series.get(
                serie_ryzen,
                0,
            )
        )

        if re.search(
            r"\bRyzen\s+3\b",
            cpu_texte,
            flags=re.IGNORECASE,
        ):
            ajustement_famille = -35

        elif re.search(
            r"\bRyzen\s+7\b",
            cpu_texte,
            flags=re.IGNORECASE,
        ):
            ajustement_famille = 35

        elif re.search(
            r"\bRyzen\s+9\b",
            cpu_texte,
            flags=re.IGNORECASE,
        ):
            ajustement_famille = 80

        else:
            ajustement_famille = 0

        return (
            ajustement_generation
            +
            ajustement_famille
        )

    return None


def base_portable_bureautique(cpu):
