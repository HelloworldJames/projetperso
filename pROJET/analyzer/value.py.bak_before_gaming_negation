        "ssd" in texte
        or
        "nvme" in texte
    ):
        if capacite >= 2048:
            return 100

        if capacite >= 1024:
            return 60

        if capacite >= 512:
            return 30

        if capacite <= 128:
            return -20

        return 0

    # HDD seul : faible valeur ajoutée.
    if (
        "hdd" in texte
        and
        capacite >= 1024
    ):
        return 10

    return 0


def ajustement_gamme_portable(
    gamme,
):
    if not gamme:
        return 0

    premium = {
        "ROG Zephyrus": 70,
        "ROG Strix": 50,
        "ROG": 35,
        "Legion": 45,
        "Predator": 35,
        "Alienware": 70,
        "Blade": 80,
        "AORUS": 40,
        "XPS": 55,
        "GS": 35,
        "Omen": 25,
    }

    return premium.get(
        gamme,
        0,
    )


def ajustement_ecran_portable(
    machine,
):
    ajustement = 0

    ecran = machine.get(
        "ecran"
    )

    frequence = machine.get(
        "frequence_ecran"
    )

    if ecran:
        try:
            taille = float(
                str(ecran)
                .replace(
                    " pouces",
                    "",
                )
            )

            if taille >= 17:
                ajustement += 15

        except ValueError:
            pass

    if frequence:
        match = re.search(
            r"(\d+)",
            str(frequence),
        )

        if match:
            hz = int(
                match.group(1)
            )

            if hz >= 240:
                ajustement += 45

            elif hz >= 165:
                ajustement += 35

            elif hz >= 144:
                ajustement += 25

            elif hz >= 120:
                ajustement += 15

    return ajustement


def construire_estimation_portable_windows(
    annonce,
    detection,
):
    machine = (
        detection.get(
            "machine_portable_windows"
        )
        or
        detecter_machine_portable_windows(
            annonce
        )
    )

    if not machine:
        return None

    cpu = machine.get(
        "cpu"
    )

    gpu = machine.get(
        "gpu"
    )

    ram = machine.get(
        "ram"
    )

    stockage = machine.get(
        "stockage"
    )

    gamme = machine.get(
        "gamme"
    )

    composants = [
        valeur
        for valeur in (
            machine.get("marque"),
            gamme,
            gpu,
            cpu,
            ram,
            stockage,
            machine.get("ecran"),
            machine.get("frequence_ecran"),
        )
        if valeur
    ]

    raisons_blocage = []
    base = None
    reference_machine = None
    confiance_score = 0

    # --------------------------------------------------------
    # PORTABLE AVEC GPU DEDIE
    # --------------------------------------------------------

    if gpu:
        base = PORTABLE_GPU_BASE.get(
            gpu
        )

        if base is None:
            raisons_blocage.append(
                "GPU portable détecté mais aucune "
                "base de valorisation fiable n'est disponible"
            )

        if cpu is None:
            raisons_blocage.append(
                "CPU précis manquant pour valoriser "
                "le portable gaming"
            )

        if (
            base is not None
            and
            cpu is not None
        ):
            reference_machine = (
                f"portable GPU {gpu}"
            )

            ajustement_cpu = (
                ajustement_cpu_portable(
                    cpu
                )
            )

            if ajustement_cpu is None:
                raisons_blocage.append(
                    "Génération CPU portable non reconnue"
                )

            else:
                base += ajustement_cpu
                confiance_score = 68

    # --------------------------------------------------------
    # PORTABLE SANS GPU DEDIE
    # --------------------------------------------------------

    else:
        if est_gaming(
            annonce
        ):
            raisons_blocage.append(
                "Portable gaming annoncé mais GPU "
                "dédié non identifié"
            )

        else:
            base = (
                base_portable_bureautique(
                    cpu
                )
            )

            if base is None:
                raisons_blocage.append(
                    "CPU précis requis pour valoriser "
                    "ce portable"
                )

            else:
                reference_machine = (
                    f"portable CPU {cpu}"
                )

                confiance_score = 55

    # --------------------------------------------------------
    # BLOCAGE SI BASE INSUFFISANTE
    # --------------------------------------------------------

    if (
        base is None
        or raisons_blocage
    ):
        estimation = {
            "statut":
                "MACHINE_COMPLETE_REQUISE",

            "analyse_autorisee":
                False,

            "raisons_blocage":
                raisons_blocage
                or [
                    "Informations insuffisantes pour "
                    "valoriser ce portable"
                ],

            "valeur_composants":
                0,

            "valeur_basse":
                0,

            "valeur_probable":
                0,

            "valeur_haute":
                0,

            "confiance":
                "🔴 TRÈS FAIBLE",

            "confiance_score":
                20,

            "categories_detectees":
                {
                    categorie
                    for categorie in (
                        "gpu",
                        "cpu",
                        "ram",
                        "stockage",
                    )
                    if detection.get(
                        categorie
                    )
                },

            "categories_valorisees":
                set(),

            "categories_fiables":
                set(),

            "categories_manquantes":
                set(),

            "categories_critiques_non_fiables":
                set(),

            "composants_valorises":
                [],

            "composants_non_valorises":
                composants,

            "composants_valorisation_non_fiable":
                [],

            "detection_composants":
                detection,

            "references_prix_utilisees":
                {},

            "coherence":
                {
                    "coherent":
                        True,

                    "problemes":
                        [],
                },

            "mode_valorisation":
                "machine_complete_portable_windows",

            "machine":
                machine,
        }

        return (
            0,
            composants,
            estimation,
        )

    # --------------------------------------------------------
    # AJUSTEMENTS CONFIGURATION
    # --------------------------------------------------------

    valeur_probable = (
        base
        +
        ajustement_ram_portable(
            ram
        )
        +
        ajustement_stockage_portable(
            stockage
        )
        +
        ajustement_gamme_portable(
            gamme
        )
        +
        ajustement_ecran_portable(
            machine
        )
    )

    valeur_probable = max(
        70,
        round(
            valeur_probable
        ),
    )

    # Fourchette plus large que sur un desktop :
    # état de batterie, écran, châssis, TGP GPU et modèle exact
    # influencent fortement un portable.
    pourcentage = (
        0.16
        if gpu
        else 0.20
    )

    marge_fourchette = max(
        50,
        round(
            valeur_probable
            * pourcentage
        ),
    )

    valeur_basse = max(
        0,
        valeur_probable
        -
        marge_fourchette,
    )

    valeur_haute = (
        valeur_probable
        +
        marge_fourchette
    )

    details = sum(
        valeur is not None
        for valeur in (
            ram,
            stockage,
            machine.get(
                "ecran"
            ),
            machine.get(
                "frequence_ecran"
            ),
            gamme,
        )
    )

    confiance_score += min(
        17,
        details * 3,
    )

    confiance_score = min(
        85,
        confiance_score,
    )

    if confiance_score >= 75:
        confiance = (
            "🟢 BONNE"
        )

    elif confiance_score >= 60:
        confiance = (
            "🟡 MOYENNE"
        )

    else:
        confiance = (
            "🟠 FAIBLE"
        )

    categories_detectees = {
        categorie
        for categorie in (
            "gpu",
            "cpu",
            "ram",
            "stockage",
        )
        if detection.get(
            categorie
        )
    }

    estimation = {
        "statut":
            "COMPLETE",

        "analyse_autorisee":
            True,

        "raisons_blocage":
            [],

        # Portable = valeur machine complète.
        "valeur_composants":
            0,

        "valeur_basse":
            valeur_basse,

        "valeur_probable":
            valeur_probable,

        "valeur_haute":
            valeur_haute,

        "confiance":
            confiance,

        "confiance_score":
            confiance_score,

        "categories_detectees":
            categories_detectees,

        "categories_valorisees":
            categories_detectees,

        "categories_fiables":
            categories_detectees,

        "categories_manquantes":
            set(),

        "categories_critiques_non_fiables":
            set(),

        "composants_valorises":
            composants,

        "composants_non_valorises":
            [],

        "composants_valorisation_non_fiable":
            [],

        "detection_composants":
            detection,

        "references_prix_utilisees":
            {
                "machine":
                    reference_machine,
            },

        "coherence":
            {
                "coherent":
                    True,

                "problemes":
                    [],
            },

        "mode_valorisation":
            "machine_complete_portable_windows",

        "machine":
            machine,

        "base_machine":
            base,
    }

    return (
        valeur_probable,
        composants,
        estimation,
    )


