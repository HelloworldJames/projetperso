def construire_estimation_apple(
    annonce,
    detection,
):
    machine = (
        detection.get(
            "machine_apple"
        )
        or
        detecter_machine_apple(
            annonce
        )
    )

    if not machine:
        return None

    modele = machine.get(
        "modele"
    )

    puce = machine.get(
        "puce"
    )

    annee = machine.get(
        "annee"
    )

    ram = machine.get(
        "ram"
    )

    stockage = machine.get(
        "stockage"
    )

    ecran = machine.get(
        "ecran"
    )

    base = None
    reference_machine = None
    confiance_score = 0

    # --------------------------------------------------------
    # APPLE SILICON
    # --------------------------------------------------------

    if puce:
        base = (
            APPLE_SILICON_BASE.get(
                (
                    modele,
                    puce,
                )
            )
        )

        if base is not None:
            reference_machine = (
                f"{modele} {puce}"
            )

            confiance_score = 70

    # --------------------------------------------------------
    # INTEL + ANNEE
    # --------------------------------------------------------

    if (
        base is None
        and
        annee is not None
    ):
        base = (
            trouver_base_intel_apple(
                modele,
                annee,
            )
        )

        if base is not None:
            reference_machine = (
                f"{modele} {annee}"
            )

            confiance_score = 60

    composants = [
        valeur
        for valeur in (
            modele,
            puce,
            machine.get("cpu"),
            ram,
            stockage,
            ecran,
        )
        if valeur
    ]

    # --------------------------------------------------------
    # MODELE APPLE TROUVE MAIS PAS ASSEZ PRECIS
    # --------------------------------------------------------

    if base is None:
        raison = (
            "Modèle Apple identifié, mais année ou puce "
            "insuffisante pour une valorisation fiable"
        )

        estimation = {
            "statut":
                "MACHINE_COMPLETE_REQUISE",

            "analyse_autorisee":
                False,

            "raisons_blocage":
                [raison],

            "valeur_composants":
                0,

            "valeur_basse":
                0,

            "valeur_probable":
                0,

            "valeur_haute":
                0,

            "confiance":
                "🔴 TRÈS FAIBLE",

            "confiance_score":
                20,

            "categories_detectees":
                set(),

            "categories_valorisees":
                set(),

            "categories_fiables":
                set(),

            "categories_manquantes":
                set(),

            "categories_critiques_non_fiables":
                set(),

            "composants_valorises":
                [],

            "composants_non_valorises":
                composants,

            "composants_valorisation_non_fiable":
                [],

            "detection_composants":
                detection,

            "references_prix_utilisees":
                {},

            "coherence":
                {
                    "coherent":
                        True,

                    "problemes":
                        [],
                },

            "mode_valorisation":
                "machine_complete_apple",

            "machine":
                machine,
        }

        return (
            0,
            composants,
            estimation,
        )

    # --------------------------------------------------------
    # CONFIGURATION
    # --------------------------------------------------------

    ajustements = (
        ajustement_ram_apple(
            ram
        )
        +
        ajustement_stockage_apple(
            stockage,
            puce=puce,
        )
        +
        ajustement_ecran_apple(
            modele,
            ecran,
        )
    )

    valeur_probable = (
        base
        +
        ajustements
    )

    # Fourchette volontairement large :
    # batterie, clavier, écran, chargeur et état
    # ne sont pas encore tous scorés.
    marge_fourchette = max(
        50,
        round(
            valeur_probable
            * 0.12
        ),
    )

    valeur_basse = max(
        0,
        valeur_probable
        -
        marge_fourchette,
    )

    valeur_haute = (
        valeur_probable
        +
        marge_fourchette
    )

    details = sum(
        valeur is not None
        for valeur in (
            ram,
            stockage,
            ecran,
            annee,
        )
    )

    confiance_score += min(
        15,
        details * 4,
    )

    confiance_score = min(
        confiance_score,
        85,
    )

    if confiance_score >= 75:
        confiance = (
            "🟢 BONNE"
        )

    elif confiance_score >= 60:
        confiance = (
            "🟡 MOYENNE"
        )

    else:
        confiance = (
            "🟠 FAIBLE"
        )

    estimation = {
        "statut":
            "COMPLETE",

        "analyse_autorisee":
            True,

        "raisons_blocage":
            [],

        # Apple = machine complète.
        # Ne pas additionner des composants soudés.
        "valeur_composants":
            0,

        "valeur_basse":
            valeur_basse,

        "valeur_probable":
            valeur_probable,

        "valeur_haute":
            valeur_haute,

        "confiance":
            confiance,

        "confiance_score":
            confiance_score,

        "categories_detectees":
            set(),

        "categories_valorisees":
            set(),

        "categories_fiables":
            set(),

        "categories_manquantes":
            set(),

        "categories_critiques_non_fiables":
            set(),

        "composants_valorises":
            composants,

        "composants_non_valorises":
            [],

        "composants_valorisation_non_fiable":
            [],

        "detection_composants":
            detection,

        "references_prix_utilisees":
            {
                "machine":
                    reference_machine,
            },

        "coherence":
            {
                "coherent":
                    True,

                "problemes":
                    [],
            },

        "mode_valorisation":
            "machine_complete_apple",

        "machine":
            machine,

        "base_machine":
            base,

        "ajustements_configuration":
            ajustements,
    }

    return (
        valeur_probable,
        composants,
        estimation,
    )


