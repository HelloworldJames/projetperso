            7: 420,
            8: 500,
            9: 560,
        }

        base = bases.get(
            serie_ryzen
        )

        if base is None:
            return None

        if re.search(
            r"\bRyzen\s+3\b",
            cpu_texte,
            flags=re.IGNORECASE,
        ):
            base -= 35

        elif re.search(
            r"\bRyzen\s+7\b",
            cpu_texte,
            flags=re.IGNORECASE,
        ):
            base += 45

        elif re.search(
            r"\bRyzen\s+9\b",
            cpu_texte,
            flags=re.IGNORECASE,
        ):
            base += 90

        return max(
            90,
            base,
        )

    return None


