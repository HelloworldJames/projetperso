def trouver_reference_prix(
    categorie,
    valeur_detectee,
):
    valeur_normalisee = (
        normaliser_reference(
            valeur_detectee
        )
    )

    # Correspondance exacte CPU / GPU / RAM / stockage.
    for composant, infos in (
        PRIX_COMPOSANTS.items()
    ):
        if (
            infos.get(
                "categorie"
            )
            != categorie
        ):
            continue

        references = [
            composant,
            *infos.get(
                "aliases",
                []
            ),
        ]

        for reference in references:
            if (
                normaliser_reference(
                    reference
                )
                ==
                valeur_normalisee
            ):
                return (
                    composant,
                    infos,
                )

    # Correspondance souple UNIQUEMENT RAM / stockage.
    #
    # On refuse pour CPU/GPU pour éviter :
    # i5-13400F -> mauvais "i5"
    # RTX 4060 -> mauvaise RTX
    if categorie not in {
        "ram",
        "stockage",
    }:
        return (
            None,
            None,
        )

    for composant, infos in (
        PRIX_COMPOSANTS.items()
    ):
        if (
            infos.get(
                "categorie"
            )
            != categorie
        ):
            continue

        references = [
            composant,
            *infos.get(
                "aliases",
                []
            ),
        ]

        for reference in references:
            reference_normalisee = (
                normaliser_reference(
                    reference
                )
            )

            if (
                reference_normalisee
                and
                reference_normalisee
                in valeur_normalisee
            ):
                return (
                    composant,
                    infos,
                )

    return (
        None,
        None,
    )


