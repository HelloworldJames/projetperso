def normaliser_capacite_stockage(
    nombre,
    unite,
):
    nombre = str(
        nombre
    ).replace(
        ",",
        ".",
    )

    try:
        valeur = float(
            nombre
        )

    except ValueError:
        return (
            f"{nombre} "
            f"{str(unite).upper()}"
        )

    unite = str(
        unite
    ).lower()

    if unite in {
        "to",
        "tb",
    }:
        if valeur.is_integer():
            valeur = int(
                valeur
            )

        return (
            f"{valeur} To"
        )

    if valeur.is_integer():
        valeur = int(
            valeur
        )

    return (
        f"{valeur} Go"
    )


def detecter_stockage(texte):
    resultats = []

    # NVMe
    match = re.search(
        r"\bnvme\b"
        r"(?:\s*(?:de\s+)?)?"
        r"(\d+(?:[.,]\d+)?)?"
        r"\s*(to|tb|go|gb)?",
        texte,
        flags=re.IGNORECASE,
    )

    if match:
        valeur = "NVMe"

        if (
            match.group(1)
            and
            match.group(2)
        ):
            valeur += (
                " "
                + normaliser_capacite_stockage(
                    match.group(1),
                    match.group(2),
                )
            )

        ajouter_unique(
            resultats,
            valeur,
        )

    # SSD
    match = re.search(
        r"\bssd\b"
        r"(?:\s*(?:de\s+)?)?"
        r"(\d+(?:[.,]\d+)?)?"
        r"\s*(to|tb|go|gb)?",
        texte,
        flags=re.IGNORECASE,
    )

    if match:
        valeur = "SSD"

        if (
            match.group(1)
            and
            match.group(2)
        ):
            valeur += (
                " "
                + normaliser_capacite_stockage(
                    match.group(1),
                    match.group(2),
                )
            )

        ajouter_unique(
            resultats,
            valeur,
        )

    # HDD / disque dur
    match = re.search(
        r"\b(?:hdd|disque\s+dur)\b"
        r"(?:\s*(?:de\s+)?)?"
        r"(\d+(?:[.,]\d+)?)?"
        r"\s*(to|tb|go|gb)?",
        texte,
        flags=re.IGNORECASE,
    )

    if match:
        valeur = "HDD"

        if (
            match.group(1)
            and
            match.group(2)
        ):
            valeur += (
                " "
                + normaliser_capacite_stockage(
                    match.group(1),
                    match.group(2),
                )
            )

        ajouter_unique(
            resultats,
            valeur,
        )

    return resultats


def detecter_stockage_generique(
    texte,
):
    """
    Utile surtout pour les Mac :
    'stockage 512 Go'
    'capacité 750 Go'
    '1 To de stockage'
    """

    motifs = [
        (
            r"\b(?:stockage|capacite|disque)"
            r"\s*[:\-]?\s*"
            r"(\d+(?:[.,]\d+)?)"
            r"\s*(to|tb|go|gb)\b"
        ),
        (
            r"\b(\d+(?:[.,]\d+)?)"
            r"\s*(to|tb|go|gb)"
            r"\s+(?:de\s+)?"
            r"(?:stockage|capacite|disque)\b"
        ),
    ]

    for motif in motifs:
        match = re.search(
            motif,
            texte,
            flags=re.IGNORECASE,
        )

        if match:
            return normaliser_capacite_stockage(
                match.group(1),
                match.group(2),
            )

    return None


# ============================================================
# MACHINE APPLE
# ============================================================

def detecter_machine_apple(annonce):
    texte = texte_annonce(
        annonce
    )

    modele = None

    if re.search(
        r"\bmac\s*book\s+air\b",
        texte,
    ):
        modele = "MacBook Air"

    elif re.search(
        r"\bmac\s*book\s+pro\b",
        texte,
    ):
        modele = "MacBook Pro"

    elif re.search(
        r"\bimac\b",
        texte,
    ):
        modele = "iMac"

    elif re.search(
        r"\bmac\s*mini\b",
        texte,
    ):
        modele = "Mac mini"

    elif re.search(
        r"\bmac\s*studio\b",
        texte,
    ):
        modele = "Mac Studio"

    elif re.search(
        r"\bmac\s+pro\b",
        texte,
    ):
        modele = "Mac Pro"

    if modele is None:
        return None

    annees = [
        int(valeur)
        for valeur in re.findall(
            r"\b(20(?:0[8-9]|1\d|2[0-6]))\b",
            texte,
        )
    ]

    annee = (
        max(annees)
        if annees
        else None
    )

    puces = detecter_puce_apple(
        texte
    )

    puce = (
        puces[0]
        if puces
        else None
    )

    cpus = detecter_cpu(
        texte
    )

    cpu = (
        cpus[0]
        if cpus
        else None
    )

    ram = detecter_ram(
        texte
    )

    stockage_liste = (
        detecter_stockage(
            texte
        )
    )

    stockage = (
        stockage_liste[0]
        if stockage_liste
        else detecter_stockage_generique(
            texte
        )
    )

    ecran = None

    match_ecran = re.search(
        r"\b("
        r"11|12|13|14|15|16|"
        r"21(?:[.,]5)?|24|27"
        r")\s*"
        r"(?:pouces?|\"|inch)\b",
        texte,
        flags=re.IGNORECASE,
    )

    if match_ecran:
        ecran = (
            match_ecran.group(1)
            .replace(
                ",",
                ".",
            )
            + " pouces"
        )

    return {
        "modele":
            modele,

        "annee":
            annee,

        "puce":
            puce,

        "cpu":
            cpu,

        "ram":
            (
                ram[0]
                if ram
                else None
            ),

        "stockage":
            stockage,

        "ecran":
            ecran,
    }




